DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Use "mysql" after configuring a local MySQL database; SQLite is the local default.
DB_ENGINE=sqlite
DB_NAME=furninest
DB_USER=furninest
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
ORDER_SHIPPING_FEE=0.00
ORDER_TAX_RATE_PERCENT=0
# Add Razorpay test credentials from the Razorpay Dashboard API Keys page in Test Mode.
# The key ID must start with rzp_test_. Never expose the key secret in frontend files.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Keep this key in the backend environment; do not expose it in frontend variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Email delivery. For Gmail, generate an App Password in Google Account Security
# (requires 2-Step Verification); do not use your normal Gmail sign-in password.
EMAIL_BACKEND=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-google-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=
